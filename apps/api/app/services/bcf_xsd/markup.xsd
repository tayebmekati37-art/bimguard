<?xml version="1.0" encoding="UTF-8"?>
<!--
  BIMGuard subset schema for markup.bcf.
  Describes the exact shape produced by app/services/bcf.py:_markup_xml.
  This is NOT the full buildingSMART BCF 2.1 schema; it covers topics,
  labels and comments only. See docs/architecture/bcf.md.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:element name="Markup">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="Topic" maxOccurs="unbounded">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="Title" type="xs:string"/>
              <xs:element name="Priority" type="xs:string" minOccurs="0"/>
              <xs:element name="CreationDate" type="xs:dateTime"/>
              <xs:element name="CreationAuthor" type="xs:string"/>
              <xs:element name="ModifiedDate" type="xs:dateTime" minOccurs="0"/>
              <xs:element name="ModifiedAuthor" type="xs:string" minOccurs="0"/>
              <xs:element name="Description" type="xs:string" minOccurs="0"/>
              <xs:element name="Labels" minOccurs="0">
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="Label" type="xs:string" maxOccurs="unbounded"/>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>
              <xs:element name="Comment" minOccurs="0" maxOccurs="unbounded">
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="Date" type="xs:dateTime"/>
                    <xs:element name="Author" type="xs:string"/>
                    <xs:element name="Comment" type="xs:string"/>
                  </xs:sequence>
                  <xs:attribute name="Guid" type="xs:string" use="required"/>
                </xs:complexType>
              </xs:element>
            </xs:sequence>
            <xs:attribute name="Guid" type="xs:string" use="required"/>
            <xs:attribute name="TopicType" type="xs:string" use="required"/>
            <xs:attribute name="TopicStatus" type="xs:string" use="required"/>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>